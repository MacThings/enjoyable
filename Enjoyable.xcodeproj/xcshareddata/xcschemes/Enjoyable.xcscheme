            <ActionContent
               title = "Run Script"
               scriptText = "#!/bin/zsh&#10;&#10;# Xcode Clang Probe Watchdog&#10;#&#10;# Beendet ausschlie&#xdf;lich die bekannte h&#xe4;ngende Compiler-Probe:&#10;#&#10;#   clang -v -E -dM ... -c /dev/null&#10;#&#10;# Der W&#xe4;chter l&#xe4;uft nur kurz nach Buildstart und beendet sich anschlie&#xdf;end&#10;# automatisch.&#10;&#10;WATCH_SECONDS=120&#10;CHECK_INTERVAL=1&#10;&#10;LOG_PREFIX=&quot;[Xcode Probe Watchdog]&quot;&#10;&#10;kill_hanging_clang_probes() {&#10;    local pids&#10;&#10;    pids=&quot;$(&#10;        ps -axo pid=,user=,command= | awk -v current_user=&quot;$USER&quot; &apos;&#10;            $2 == current_user &amp;&amp;&#10;            /XcodeDefault\.xctoolchain\/usr\/bin\/clang/ &amp;&amp;&#10;            / -v -E -dM / &amp;&amp;&#10;            / -c \/dev\/null/ {&#10;                print $1&#10;            }&#10;        &apos;&#10;    )&quot;&#10;&#10;    if [[ -z &quot;$pids&quot; ]]; then&#10;        return&#10;    fi&#10;&#10;    for pid in ${(f)pids}; do&#10;        [[ -z &quot;$pid&quot; ]] &amp;&amp; continue&#10;&#10;        echo &quot;$LOG_PREFIX killing hanging clang probe PID $pid&quot;&#10;&#10;        kill -TERM &quot;$pid&quot; 2&gt;/dev/null || true&#10;&#10;        # Falls die Probe TERM ignoriert, kurz danach hart beenden.&#10;        sleep 0.2&#10;&#10;        if kill -0 &quot;$pid&quot; 2&gt;/dev/null; then&#10;            echo &quot;$LOG_PREFIX PID $pid ignored TERM; sending KILL&quot;&#10;            kill -KILL &quot;$pid&quot; 2&gt;/dev/null || true&#10;        fi&#10;    done&#10;}&#10;&#10;watch_clang_probes() {&#10;    local started_at=$SECONDS&#10;&#10;    echo &quot;$LOG_PREFIX started for ${WATCH_SECONDS}s&quot;&#10;&#10;    # Eventuell bereits vorhandene Probe direkt entfernen.&#10;    kill_hanging_clang_probes&#10;&#10;    while (( SECONDS - started_at &lt; WATCH_SECONDS )); do&#10;        sleep &quot;$CHECK_INTERVAL&quot;&#10;        kill_hanging_clang_probes&#10;    done&#10;&#10;    echo &quot;$LOG_PREFIX finished&quot;&#10;}&#10;&#10;# Wichtig: Hintergrundprozess, damit der eigentliche Build nicht blockiert.&#10;watch_clang_probes &gt;/tmp/xcode-clang-probe-watchdog-${UID}.log 2&gt;&amp;1 &amp;&#10;&#10;exit 0&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "8D1107260486CEB800E47090"
                     BuildableName = "Enjoyable.app"
                     BlueprintName = "Enjoyable"
                     ReferencedContainer = "container:Enjoyable.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
